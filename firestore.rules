rules_version = '2';

// ============================================================================
// Regras de segurança — Cronograma Acadêmico (Turma 23B)
//
// Modelo de autenticação: Firebase Authentication com e-mail/senha. As contas
// são criadas À MÃO no Firebase Console (Authentication → Users → Add user),
// uma por discente + a do presidente — sem nenhum script, sem CLI. Por isso
// estas regras NÃO usam "custom claims" (que só dariam pra gravar com um
// script/Admin SDK): o nome de usuário e o cargo são extraídos direto do
// e-mail da conta, que segue sempre o padrão "<usuario>@turma23b.local"
// (e "presidente@turma23b.local" pro presidente). Esse e-mail nunca recebe
// nenhum e-mail de verdade — é só um "nome" que o Firebase Auth exige.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function meu() { return signedIn() ? request.auth.token.email.split('@')[0] : null; }
    function presidente() { return meu() == 'presidente'; }
    function dono(usuarioDoCampo) { return signedIn() && meu() == usuarioDoCampo; }

    // ---------------- Eventos (cronograma) ----------------
    match /eventos/{id} {
      allow read: if signedIn();
      allow write: if presidente();
    }

    // ---------------- Arquivos da turma ----------------
    match /arquivos/{id} {
      allow read: if signedIn();
      allow write: if presidente();
    }

    // ---------------- Mural de avisos ----------------
    match /mural/{id} {
      allow read: if signedIn();
      allow create, update, delete: if presidente();
    }
    // Quem leu cada aviso (equivalente à aba MuralLido)
    match /muralLido/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.usuario == meu();
      allow delete: if false;
      allow update: if false;
    }
    // Votos de enquete (equivalente à aba MuralVotos)
    match /muralVotos/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.usuario == meu();
      allow delete: if signedIn() && resource.data.usuario == meu();
      allow update: if false;
    }

    // ---------------- Datas importantes ----------------
    match /datasImportantes/{id} {
      allow read: if signedIn();
      allow write: if presidente();
    }

    // ---------------- Eventos acompanhados (equivalente à aba Acompanhados) ----------------
    match /acompanhados/{id} {
      allow read: if signedIn() && resource.data.usuario == meu();
      allow create: if signedIn() && request.resource.data.usuario == meu();
      allow delete: if signedIn() && resource.data.usuario == meu();
    }

    // ---------------- Notas privadas por evento (anotação pessoal) ----------------
    // Id do documento é "<usuario>__<eventoId>", então dá pra checar o dono
    // só pelo id, sem precisar nem ler o conteúdo do documento.
    match /notas/{id} {
      allow read, write: if signedIn() && id.split('__')[0] == meu();
    }

    // ---------------- Usuários / Discentes ----------------
    // Discente só lê o próprio documento (nunca o de outro); presidente lê e
    // escreve todos. A senha de acesso às Notas (campo senhaNotasHash) nunca é
    // usada pelo cliente direto daqui — é conferida só dentro da Cloud
    // Function loginNotas, com o Admin SDK (que ignora estas regras).
    match /usuarios/{usuario} {
      allow read: if presidente() || dono(usuario);
      allow write: if presidente();
    }

    // ---------------- Avaliações (notas de prova) ----------------
    // O PRESIDENTE lê/escreve a coleção inteira (aba "Envio de Notas"). Um
    // discente só lê as PRÓPRIAS notas — e mesmo assim, o site só mostra essa
    // tela depois que ele confirma a segunda senha (campo senhaNotasHash em
    // usuarios/{usuario}), checada no navegador antes de pedir estes dados.
    match /avaliacoes/{id} {
      allow read: if presidente() || (signedIn() && resource.data.usuario == meu());
      allow write: if presidente();
    }

    // ---------------- Coordenador da Tutoria (sessão por evento) ----------------
    match /sessoesTutoria/{eventoId} {
      allow read: if signedIn();
      // Objetivos podem ser criados/editados por qualquer discente enquanto a
      // sessão não estiver encerrada; depois de encerrada, fica congelada.
      allow create: if signedIn();
      allow update: if signedIn() && resource.data.status != 'encerrada';
      allow delete: if false;
    }

    // ---------------- Configuração do semestre atual ----------------
    match /config/{chave} {
      allow read: if signedIn();
      allow write: if presidente();
    }

    // ---------------- Semestres arquivados ----------------
    // Só o presidente consegue ver/criar a lista de semestres arquivados
    // (igual ao Code.gs: discente nunca lê isso). Gravado pelo próprio
    // navegador do presidente ao "Encerrar o semestre".
    match /semestres/{id} {
      allow read, write: if presidente();
    }
    // Notas de semestres encerrados: de propósito, ningúem acessa pelo app —
    // só quem abrir o Firebase Console diretamente (mesmo espírito da aba
    // "escondida" no Google Sheets original).
    match /semestresNotasOcultas/{a=**} {
      allow read, write: if false;
    }

    // ---------------- Notificações no app (novo) ----------------
    // Sem Cloud Functions, é o próprio navegador de quem publica (presidente)
    // que grava a notificação na caixinha de cada discente; e é o próprio
    // navegador de cada discente que grava (só na própria caixinha) os
    // lembretes de evento que ele mesmo detectou enquanto o site está aberto.
    match /notificacoes/{usuario}/itens/{id} {
      allow read, update, delete: if dono(usuario);
      allow create: if presidente() || dono(usuario);
    }

    // ---------------- Fila de e-mail (não usada; sem Cloud Functions/Storage) ----------------
    match /mail/{id} {
      allow read, write: if false;
    }

    // ---------------- Controle de lembretes de evento já enviados ----------------
    // Cada discente controla só os PRÓPRIOS lembretes (1 dia/1 hora/30 min),
    // calculados no navegador dele enquanto o site está aberto — por isso é
    // uma subcoleção por usuário, igual a "notificacoes" acima.
    match /lembretesEnviados/{usuario}/itens/{id} {
      allow read, write: if dono(usuario);
    }

    // ---------------- Push (aparelhos que recebem notificação com o app fechado) ----------------
    // Id = sha256 do token do aparelho (só o próprio aparelho conhece o token).
    // Cada pessoa grava/atualiza só o registro com o PRÓPRIO usuário; se outra
    // pessoa entrar no mesmo celular, o registro passa pra ela. Ninguém lê pelo
    // app — quem lê é o Worker da Cloudflare (push-worker/), com conta de serviço.
    match /pushTokens/{id} {
      allow read: if false;
      allow create, update: if signedIn() && request.resource.data.usuario == meu()
                            && request.resource.data.token is string && request.resource.data.token.size() < 4096;
      allow delete: if signedIn() && resource.data.usuario == meu();
    }

    // ---------------- Lembretes de 2h antes já enviados (controle do Worker) ----------------
    match /lembretes2h/{id} {
      allow read, write: if false;
    }
  }
}
